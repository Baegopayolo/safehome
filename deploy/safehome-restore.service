[Unit]
Description=SafeHome isolated PostgreSQL restore drill
Wants=network-online.target
After=network-online.target
OnFailure=safehome-monitor.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/safehome-current
EnvironmentFile=-/home/ubuntu/.config/safehome-maintenance.env
ExecStart=/home/ubuntu/safehome-current/venv/bin/python -B deploy/dashboard_maintenance.py restore
ExecStartPost=/usr/bin/touch /home/ubuntu/.local/state/safehome/restore.ok
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/safehome
