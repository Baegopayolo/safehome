[Unit]
Description=SafeHome verified Seoul apartment jeonse collection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/safehome-current
EnvironmentFile=/home/ubuntu/.config/safehome-dashboard.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/home/ubuntu/safehome-current/venv/bin/python -m flask --app backend/app check-data-storage
ExecStartPre=/home/ubuntu/safehome-current/venv/bin/python -m flask --app backend/app backup-db --directory /home/ubuntu/safehome-backups/scheduled
ExecStart=/home/ubuntu/safehome-current/venv/bin/python -m flask --app backend/app sync-dashboard --mode scheduled
TimeoutStartSec=4h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/safehome /home/ubuntu/safehome-backups
