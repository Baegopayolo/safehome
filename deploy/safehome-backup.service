[Unit]
Description=SafeHome daily verified database backup
Wants=network-online.target
After=network-online.target
OnFailure=safehome-monitor.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/safehome-current
EnvironmentFile=/home/ubuntu/.config/safehome-dashboard.env
EnvironmentFile=-/home/ubuntu/.config/safehome-maintenance.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/safehome-current/venv/bin/python -B deploy/dashboard_maintenance.py backup
ExecStartPost=/usr/bin/touch /home/ubuntu/.local/state/safehome/backup.ok
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/safehome /home/ubuntu/safehome-backups
