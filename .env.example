# Load these in the web process AND the collection service. Never commit real keys.
SECRET_KEY=replace-with-your-existing-production-secret
# Local SQLite example only. Production uses its existing PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:////var/lib/safehome/site.db
MOLIT_RENT_API_KEY=
# Fallback only if this key has the apartment-rent API permission:
MOLIT_API_KEY=
KAKAO_APP_KEY=
DASHBOARD_STALE_HOURS=192
DASHBOARD_LOCK_PATH=/var/lib/safehome/dashboard.lock
